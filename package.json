{
  "name": "gemma-figma-mcp",
  "version": "0.1.0",
  "description": "MCP server for Figma built for local models (Hermes Agent / LM Studio) and hosted ones (Claude Code, Codex)",
  "private": true,
  "type": "module",
  "bin": {
    "gemma-figma-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc && npm run build:plugin",
    "build:server": "tsc",
    "build:plugin": "cd plugin && npm run build",
    "start": "node dist/server.js",
    "bridge": "node dist/daemon.js",
    "bridge:dev": "tsx src/daemon.ts",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && cd plugin && npm run typecheck",
    "docs:tools": "node scripts/gen-tool-docs.mjs",
    "measure:tools": "node scripts/measure-tools.mjs",
    "smoke:plugin": "node scripts/smoke-plugin.mjs",
    "eval": "node scripts/eval/run-eval.mjs",
    "eval:live": "node scripts/eval/run-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.5",
    "lucide": "^1.55.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
