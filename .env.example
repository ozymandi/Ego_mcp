# Figma Personal Access Token
# Create at: https://www.figma.com/settings -> Security -> Personal access tokens
# Scopes: file_content:read, file_comments:write, library_assets:read,
#   library_content:read, current_user:read (plus file_variables:read for
#   the Variables REST tools, Enterprise only)
FIGMA_TOKEN=

# Optional: default file key used when a REST tool call omits file_key
FIGMA_DEFAULT_FILE_KEY=

# Optional: WebSocket port of the bridge daemon (plugin + MCP server connect here)
FIGMA_BRIDGE_PORT=7575
# Optional: full daemon URL; overrides the port above
# FIGMA_BRIDGE_URL=ws://localhost:7575
# Optional: set to 0 to stop the MCP server from starting the daemon itself
# FIGMA_BRIDGE_AUTOSTART=1

# Optional: hard cap on characters per text tool result (default 20000).
# Keeps local-model contexts from overflowing; results end with a
# "...[truncated]" marker when cut.
# FIGMA_MCP_MAX_RESULT_CHARS=20000

# Optional: how many files to keep in ./screenshots (default 50, 0 = keep all)
# FIGMA_SCREENSHOT_KEEP=50
